
#call for creating
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"django1",
    "email":"django@gmail.com",
    "password":"password@123"
}

#call for get current user detail
###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
Authorization: Basic django1:password@123

#expense endpoints
#for listing all
###
GET http://127.0.0.1:8000/v1/spending/expense/
Accept: application/json
Authorization: Basic django1:password@123

#for adding
###
POST http://127.0.0.1:8000/v1/spending/expense/
Content-Type: application/json
Authorization: Basic django1:password@123

{
    "title":"medicine",
    "amount":4000,
    "category":"FOOD",
    "payment_method":"upi"


}

#for retrieving
###
GET http://127.0.0.1:8000/v1/spending/expense/2/
Accept: application/json
Authorization: Basic django:password@123

#for updating
###
PUT http://127.0.0.1:8000/v1/spending/expense/2/
Content-Type: application/json
Authorization: Basic django1:password@123


{
  "id": 3,
  "title": "medicine",
  "amount": "4000.00",
  "category": "HEALTH",
  "priority": "need",
  "payment_method": "upi",
  "created_at": "2026-10-09T14:31:47.168482Z",
  "updated_at": "2026-10-09T14:31:47.168500Z",
  "owner": 2
}


#for deleting
###
DELETE http://127.0.0.1:8000/v1/spending/expense/3/
Accept: application/json
Authorization: Basic django:password@123

